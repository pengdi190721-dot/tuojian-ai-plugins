    "shortDescription": "\u5148\u627e\u5230\u5bb9\u6613\u83b7\u5ba2\u7684\u5b9a\u4f4d\uff0c\u518d\u628a\u9009\u9898\u3001\u5bf9\u6807\u62c6\u89e3\u3001\u5199\u7a3f\u3001\u5236\u4f5c\u548c\u6210\u7247\u8bc4\u5206\u4e32\u6210\u5de5\u4f5c\u6d41",
    "longDescription": "\u9762\u5411\u53e3\u64ad\u4e0eVlog\u521b\u4f5c\u8005\u7684\u81ea\u5a92\u4f53\u5de5\u4f5c\u53f0\u3002\u9996\u6b21\u4f7f\u7528\u4f1a\u4ece\u73b0\u6709\u4ea7\u54c1\u548c\u5ba2\u6237\u5012\u63a8\u83b7\u5ba2\u578b\u5185\u5bb9\u5b9a\u4f4d\uff1b\u4e4b\u540e\u53ef\u5b8c\u6574\u63a8\u8fdb\u9009\u9898\u3001\u8c03\u7814\u3001\u5bf9\u6807\u89c6\u9891\u62c6\u89e3\u6539\u5199\u3001\u4eba\u8bbe\u6821\u51c6\u3001\u811a\u672c\u3001\u5236\u4f5c\u3001\u6210\u7247\u8bc4\u5206\u548c\u53d1\u5e03\u590d\u76d8\u3002",
