    "brandColor": "#D97706",
    "defaultPrompt": [
      "\u7b2c\u4e00\u6b21\u4f7f\u7528\u81ea\u5a92\u4f53\u4f5c\u6218\u5ba4\uff0c\u8bf7\u9010\u9898\u5e2e\u6211\u627e\u5230\u6700\u9002\u5408\u83b7\u5ba2\u7684\u81ea\u5a92\u4f53\u5b9a\u4f4d\uff0c\u6bcf\u6b21\u53ea\u95ee\u4e00\u4e2a\u95ee\u9898\u3002",
      "\u6253\u5f00\u81ea\u5a92\u4f53\u4f5c\u6218\u5ba4\uff0c\u5e2e\u6211\u628a\u4eca\u5929\u7684\u60f3\u6cd5\u63a8\u8fdb\u6210\u4e00\u6761\u53ef\u62cd\u89c6\u9891\u3002",
      "\u8fd9\u662f\u6211\u62cd\u5b8c\u7684\u89c6\u9891\uff0c\u8bf7\u7528\u6210\u7247\u8bc4\u5206\u6559\u7ec3\u6253\u5206\uff0c\u5e76\u544a\u8bc9\u6211\u4e0b\u4e00\u904d\u53ea\u6539\u54ea\u4e09\u4ef6\u4e8b\u3002",
      "\u8fd9\u662f\u6211\u7684\u5bf9\u6807\u89c6\u9891\uff0c\u8bf7\u62c6\u89e3\u5b83\u7684\u7ed3\u6784\u548c\u8282\u594f\uff0c\u518d\u6539\u6210\u7b26\u5408\u6211\u5b9a\u4f4d\u7684\u539f\u521b\u7248\u672c\u3002",
      "\u68c0\u67e5\u6211\u7684\u81ea\u5a92\u4f53\u5de5\u5177\u662f\u5426\u5c31\u7eea\uff0c\u5e76\u544a\u8bc9\u6211\u7f3a\u4ec0\u4e48\u3002"
