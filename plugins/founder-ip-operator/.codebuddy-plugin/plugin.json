{
  "name": "founder-ip-operator",
  "version": "2.4.0",
  "description": "给自媒体新手用的短视频操盘手，说的都是大白话，每做完一步都告诉你下一步：IP定位、找对标出选题（附创意拍法）、口播稿两份（拍摄版和提词器用的纯文字版）与现场提问卡、对标拆解、成片打分与口播体检、付费投流、后台截图与视频复盘，采纳的建议以后自动沿用。",
  "author": {
    "name": "彭迪"
  },
  "skills": "./skills/",
  "homepage": "https://github.com/pengdi190721-dot/tuojian-ai-plugins/tree/main/plugins/founder-ip-operator",
  "repository": "https://github.com/pengdi190721-dot/tuojian-ai-plugins",
  "mcpServers": {
    "video-analyzer": {
      "command": "node",
      "args": [
        "${CODEBUDDY_PLUGIN_ROOT}/skills/founder-ip-operator/scripts/video_analyzer_mcp.js"
      ],
      "cwd": "${CODEBUDDY_PLUGIN_ROOT}",
      "env": {
        "OPENAI_API_KEY": "",
        "WHISPER_LANGUAGE": "zh",
        "MCP_WRITE_SIDECARS": "0"
      }
    }
  }
}
