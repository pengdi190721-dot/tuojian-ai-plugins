{
  "schema_version": 2,
  "policy": "bundled-routing-with-external-adapters",
  "note": "技能不复制第三方源码。视频解析器由技能按锁定版本自动调用；其他增强能力只有用户明确同意后，才按各自许可证和安装说明部署。",
  "dependencies": [
    {
      "name": "mcp-video-analyzer",
      "repository": "https://github.com/guimatheus92/mcp-video-analyzer",
      "license": "MIT",
      "role": "视频字幕读取、关键画面、文字识别、时间线和元数据解析",
      "package": "mcp-video-analyzer@0.10.0",
      "package_integrity": "sha512-DPjlu/sPWKJYYomxzDH7nOEjF9Orspz0xAVRsnI1IerklbzUdGr9hLEeTGApCzrFnKNiIEkZCC7UbKF7yqDrUQ==",
      "minimum_runtime": "Node.js 22.12.0",
      "api_token_required": false
    },
    {
      "name": "scrybe",
      "repository": "https://github.com/coroboros/scrybe",
      "license": "MIT",
      "role": "当视频没有字幕时进行本地中文语音转写",
      "package": "@coroboros/scrybe@0.2.0",
      "package_integrity": "sha512-j9NIxf7y+pQqx7BHHQFaQ3juz1PWrq43gimmMJBAH6pPm/NVkxEqfb22DSuE0qllfpB+qUUiZFtS109xGoLFCA==",
      "model": "base",
      "api_token_required": false
    },
    {
      "name": "Agent Reach",
      "repository": "https://github.com/Panniantong/Agent-Reach",
      "license": "MIT",
      "role": "跨平台检索与素材收集",
      "inspected_commit": "93ae1d1"
    },
    {
      "name": "TrendRadar",
      "repository": "https://github.com/sansan0/TrendRadar",
      "license": "GPL-3.0",
      "role": "热点聚合与候选选题",
      "inspected_commit": null
    },
    {
      "name": "nuwa-skill",
      "repository": "https://github.com/alchaincyf/nuwa-skill",
      "license": "MIT",
      "role": "个人表达风格沉淀",
      "inspected_commit": "27642f5"
    },
    {
      "name": "brand-voice",
      "repository": "https://github.com/anthropics/knowledge-work-plugins",
      "license": "MIT",
      "role": "品牌语气发现、规范生成和内容边界检查",
      "inspected_commit": "16d1ab5"
    },
    {
      "name": "getnote-cli",
      "repository": "https://www.npmjs.com/package/@getnote/cli",
      "package": "@getnote/cli",
      "role": "读视频链接：用户发来的视频链接一律存进得到大脑读文字稿，也可存资料、搜和读笔记；需要用户本人注册得到大脑、开会员并授权",
      "bundled_assets": false,
      "api_token_required": false
    },
    {
      "name": "numpy",
      "repository": "https://github.com/numpy/numpy",
      "license": "BSD-3-Clause",
      "role": "口播体检计算声音大小、停顿和语速；matplotlib（可选）画曲线图",
      "bundled_assets": false
    }
  ]
}
